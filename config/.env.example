# ========================================
# 气象雷达数据管理与预测平台
# 环境配置文件
# ========================================

# ========================================
# 应用配置
# ========================================
APP_NAME=气象雷达数据管理与预测平台
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# ========================================
# 数据库配置
# ========================================
DATABASE_HOST=localhost
DATABASE_PORT=3308
DATABASE_USER=admin
DATABASE_PASSWORD=cqsyyxydxsyc6z
DATABASE_NAME=gfs_weather
DATABASE_CHARSET=utf8mb4

# 数据库连接池配置
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ========================================
# JWT认证配置
# ========================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# 雷达数据下载配置
# ========================================
DOWNLOAD_BASE_URL=https://image.data.cma.cn/vis/RAD__B0_CR
DOWNLOAD_INTERVAL_MINUTES=6
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_TIMEOUT=30
DOWNLOAD_ENABLE_RESUME=True

# 数据存储配置
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODEL_DIR=./data/models

# ========================================
# Redis配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ========================================
# Celery配置
# ========================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=True

# ========================================
# 日志配置
# ========================================
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ========================================
# CORS配置
# ========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ========================================
# 数据处理配置
# ========================================
PROCESSING_BATCH_SIZE=10
PROCESSING_MAX_WORKERS=4
PROCESSING_CHUNK_SIZE=1000

# 数据质量控制
DBZ_MIN_VALID=-30
DBZ_MAX_VALID=75
MAX_MISSING_RATIO=0.3
OUTLIER_DETECTION=True
INTERPOLATION_METHOD=linear

# ========================================
# 预测模型配置
# ========================================

# 光流法配置
OPTICAL_FLOW_ENABLED=True
OPTICAL_FLOW_HISTORY_FRAMES=6
OPTICAL_FLOW_PREDICTION_HORIZON=360
OPTICAL_FLOW_PYRAMED_SCALE=1.2
OPTICAL_FLOW_LEVELS=3
OPTICAL_FLOW_WINSIZE=15
OPTICAL_FLOW_ITERATIONS=3
OPTICAL_FLOW_POLY_N=5
OPTICAL_FLOW_POLY_SIGMA=1.2

# Prophet模型配置
PROPHET_ENABLED=True
PROPHET_RETRAIN_INTERVAL=daily
PROPHET_MIN_DATA_POINTS=168
PROPHET_TRAINING_WINDOW=30
PROPHET_INTERVAL_WIDTH=0.8
PROPHET_YEARLY_SEASONALITY=True
PROPHET_WEEKLY_SEASONALITY=True
PROPHET_DAILY_SEASONALITY=True

# 集成模型配置
ENSEMBLE_ENABLED=False
ENSEMBLE_WEIGHTS=0.5,0.5

# ========================================
# API限流配置
# ========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# ========================================
# 文件上传配置
# ========================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=csv,xlsx,xls

# ========================================
# 监控告警配置
# ========================================
MONITORING_ENABLED=True
ALERT_EMAIL_ENABLED=False
ALERT_EMAIL_SMTP_HOST=smtp.example.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=admin@example.com
ALERT_EMAIL_TO=admin@example.com

# ========================================
# 备份配置
# ========================================
BACKUP_ENABLED=True
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ========================================
# 性能优化配置
# ========================================
CACHE_ENABLED=True
CACHE_TTL=300
QUERY_TIMEOUT=30
MAX_QUERY_RESULTS=10000

# ========================================
# 安全配置
# ========================================
SECURITY_SSL_ENABLED=False
SECURITY_SSL_CERT_FILE=
SECURITY_SSL_KEY_FILE=
SECURITY_HSTS_ENABLED=False
SECURITY_FRAME_DENY=True
SECURITY_CONTENT_TYPE_NOSNIFF=True
